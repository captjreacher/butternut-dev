{% comment %} Full-bleed hero with overlay + CTA {% endcomment %}
<section id="hero-{{ section.id }}" class="bn-hero">
  <style>
    #hero-{{ section.id }}{position:relative;min-height:{{ section.settings.height }};display:grid;place-items:center;overflow:hidden}
    #hero-{{ section.id }} .bn-img{position:absolute;inset:0}
    #hero-{{ section.id }} .bn-img img{width:100%;height:100%;object-fit:cover}
    #hero-{{ section.id }} .bn-overlay{position:absolute;inset:0;background:{{ section.settings.overlay | color_to_rgb | replace: 'rgb', 'rgba' | append: '(' }}{{ section.settings.opacity }}%)}
    #hero-{{ section.id }} .bn-content{position:relative;text-align:{{ section.settings.align }};color:{{ section.settings.text }};padding:clamp(1rem,3vw,3rem);max-width:1100px}
    #hero-{{ section.id }} .bn-eyebrow{opacity:.85;text-transform:uppercase;letter-spacing:.15em;font:700 12px/1 system-ui}
    #hero-{{ section.id }} .bn-title{margin:.5rem 0;font-weight:800;letter-spacing:-.02em;font-size:clamp(2rem,5vw,3.4rem)}
    #hero-{{ section.id }} .bn-sub{max-width:60ch;opacity:.95}
    #hero-{{ section.id }} .bn-cta{margin-top:1rem}
  </style>
  <div class="bn-img">
    <picture>
      {% if section.settings.image_mobile %}
        <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
      {% endif %}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager" fetchpriority="high">
    </picture>
  </div>
  <div class="bn-overlay" aria-hidden="true"></div>
  <div class="bn-content page-width">
    {% if section.settings.eyebrow != blank %}<div class="bn-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
    <h1 class="bn-title">{{ section.settings.title }}</h1>
    {% if section.settings.subheading != blank %}<div class="bn-sub rte">{{ section.settings.subheading }}</div>{% endif %}
    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <div class="bn-cta"><a class="button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero – full bleed",
  "settings": [
    { "type":"image_picker","id":"image","label":"Desktop image" },
    { "type":"image_picker","id":"image_mobile","label":"Mobile image (optional)" },
    { "type":"text","id":"eyebrow","label":"Eyebrow", "default":"NEW ARRIVALS" },
    { "type":"text","id":"title","label":"Title", "default":"ButternutBaby" },
    { "type":"richtext","id":"subheading","label":"Subheading" },
    { "type":"text","id":"cta_label","label":"Button label","default":"Shop now" },
    { "type":"url","id":"cta_link","label":"Button link" },
    { "type":"select","id":"align","label":"Text alignment","options":[
      {"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default":"center" },
    { "type":"color","id":"text","label":"Text color","default":"#FFFFFF" },
    { "type":"color","id":"overlay","label":"Overlay color","default":"#111827" },
    { "type":"range","id":"opacity","min":0,"max":90,"step":5,"unit":"%","label":"Overlay opacity","default":40 },
    { "type":"select","id":"height","label":"Height","options":[
      {"value":"60vh","label":"Short"},{"value":"75vh","label":"Tall"},{"value":"92vh","label":"Full"}], "default":"75vh" }
  ],
  "presets":[{"name":"Hero – full bleed"}]
}
{% endschema %}
