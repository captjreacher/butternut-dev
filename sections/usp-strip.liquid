<section id="usp-{{ section.id }}" class="bn-usp">
  <style>
    #usp-{{ section.id }}{background:{{ section.settings.bg }};color:{{ section.settings.text }}}
    #usp-{{ section.id }} .wrap{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
      gap:clamp(.75rem,2.5vw,1.25rem);align-items:center;padding:clamp(.75rem,2.5vw,1.25rem)}
    #usp-{{ section.id }} .item{display:flex;gap:.6rem;align-items:center;justify-content:center}
    #usp-{{ section.id }} img{width:22px;height:22px;object-fit:contain;filter:{{ section.settings.icon_filter }}}
  </style>
  <div class="wrap page-width">
    {% for block in section.blocks %}
      <div class="item" {{ block.shopify_attributes }}>
        {% if block.settings.icon %}<img src="{{ block.settings.icon | image_url: width: 64 }}" alt="">{% endif %}
        <div>{{ block.settings.text }}</div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
"enabled_on": { "templates": ["index", "product", "collection", "page"] },
{
  "name":"USP strip",
  "settings":[
    {"type":"color","id":"bg","label":"Background","default":"#111827"},
    {"type":"color","id":"text","label":"Text","default":"#ffffff"},
    {"type":"select","id":"icon_filter","label":"Icon style",
      "options":[{"value":"invert(0)","label":"Dark"},{"value":"invert(1)","label":"Light"}],
      "default":"invert(1)"}
  ],
  "blocks":[
    {"type":"usp","name":"USP","settings":[
      {"type":"image_picker","id":"icon","label":"Icon (png/svg)"},
      {"type":"text","id":"text","label":"Text","default":"Free shipping over $X"}
    ]}],
  "max_blocks": 6,
  "presets":[{"name":"USP strip","blocks":[{"type":"usp"},{"type":"usp"},{"type":"usp"}]}]
}
{% endschema %}
